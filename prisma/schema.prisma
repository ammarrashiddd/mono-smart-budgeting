generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  username         String            @unique
  password         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  kmeansCache   KmeansCache[]
  clusterHistories ClusterHistory[]
  financialTargets FinancialTarget[]
  transactions     Transaction[]
  aiInsights       AiInsight[]
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  description String?
  category    TransactionCategory
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  financialTargetId String? 
  financialTarget   FinancialTarget? @relation(fields: [financialTargetId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([financialTargetId])
}

model FinancialTarget {
  id            String    @id @default(uuid())
  userId        String
  title         String
  targetAmount  Float
  currentAmount Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  transactions Transaction[]
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClusterHistory {
  id               String   @id @default(uuid())
  userId           String
  optimalK         Int
  assignedCluster  Int
  totalPemasukan   Float
  totalPengeluaran Float
  sisaSaldo        Float
  kategoriTerbesar String
  kondisiKesehatan String
  aiSaranText      String?
  reviewGoals      String?
  calculatedAt     DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KmeansCache {
  id              String   @id @default(uuid())
  userId          String   
  month           Int      
  year            Int      
  optimalK        Int
  assignedCluster Int
  wcss            Float
  points          Json     
  elbow           Json     
  totalTx         Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
}

model AiInsight {
  id               String   @id @default(uuid())
  userId           String   
  month            Int      
  year             Int
  kategoriTerbesar String
  kondisiKesehatan String
  aiSaranText      String   @db.Text
  reviewGoals      String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  dataHash         String   @default("") @db.Text

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
}

enum TransactionCategory {
  MAKANAN_MINUMAN    
  TAGIHAN   
  TRANSPORTASI       
  PENDIDIKAN  
  KESEHATAN          
  HIBURAN_GAYA_HIDUP 
  BELANJA_FASHION   
  HOBI
  PEMASUKAN          
  INVESTASI_TABUNGAN 
  LAIN_LAIN          
}