generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  username         String            @unique
  password         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  kmeansCache   KmeansCache?
  clusterHistories ClusterHistory[]
  financialTargets FinancialTarget[]
  transactions     Transaction[]
  aiInsights       AiInsight[]
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  financialTargetId String? 
  financialTarget   FinancialTarget? @relation(fields: [financialTargetId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([financialTargetId])
}

model FinancialTarget {
  id            String    @id @default(uuid())
  userId        String
  title         String
  targetAmount  Float
  currentAmount Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  transactions Transaction[]
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClusterHistory {
  id               String   @id @default(uuid())
  userId           String
  optimalK         Int
  assignedCluster  Int
  personaName      String
  totalPemasukan   Float
  totalPengeluaran Float
  sisaSaldo        Float
  kategoriTerbesar String
  kondisiKesehatan String
  aiSaranText      String?
  calculatedAt     DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KmeansCache {
  id          String   @id @default(cuid())
  userId      String   @unique
  optimalK    Int
  wcss        Float
  points      Json     
  elbow       Json     
  totalTx     Int      
  lastTxId    String?  
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiInsight {
  id               String   @id @default(uuid())
  userId           String   @unique // UBAH MENJADI @unique AGAR BERPERILAKU SEPERTI CACHE
  personaName      String
  kategoriTerbesar String
  kondisiKesehatan String
  aiSaranText      String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt // Tambahan opsional untuk memantau waktu update cache

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}